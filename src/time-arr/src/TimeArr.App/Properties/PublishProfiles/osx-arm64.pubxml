<Project>
  <!-- Self-contained single-file Release build for osx-arm64, published to bin/publish/osx-arm64/. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin/publish/osx-arm64/</PublishDir>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Avalonia binds through reflection, so trimming would break it. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Symbols inside the binary keep line numbers in crash-log stack traces without loose .pdb files. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
