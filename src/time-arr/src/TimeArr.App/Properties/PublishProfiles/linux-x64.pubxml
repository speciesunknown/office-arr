<Project>
  <!-- Self-contained single-file Release build for linux-x64, published to bin/publish/linux-x64/. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin/publish/linux-x64/</PublishDir>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Native libraries (SQLite, Skia) go inside the one file too, so publishing to a bin folder with -o adds only time-arr. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Avalonia binds through reflection, so trimming would break it. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
