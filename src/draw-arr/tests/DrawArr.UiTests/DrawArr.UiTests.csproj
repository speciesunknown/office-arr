<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless Avalonia tests for the window and canvas, in their own project because Avalonia.Headless.XUnit 12 needs xUnit v3. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The manual clock is shared with the unit tests so autosave timing can be driven here too. -->
  <ItemGroup>
    <Compile Include="..\DrawArr.Tests\ManualClock.cs" Link="ManualClock.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DrawArr.App\DrawArr.App.csproj" />
  </ItemGroup>

</Project>
